# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=studysync
DB_PORT=3306
PORT=5000

# Upstream Partner (SettleIn)
# Swap this for their live tunnel URL when integrating
SETTLEIN_URL=https://your-partner-tunnel.trycloudflare.com
SETTLEIN_API_KEY=your-partner-api-key-here

# Week 9 Security: API Keys
# One per consumer, comma-separated. Never commit real keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=consumer-one-key-here,consumer-two-key-here